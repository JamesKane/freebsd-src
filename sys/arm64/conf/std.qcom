#
# Qualcomm SoC support
#

# Qualcomm Snapdragon drivers
device		qcom_epss		# EPSS CPU frequency control
device		qcom_gcc		# Global Clock Controller
device		qcom_geni_i2c		# GENI I2C controllers
device		qcom_mdio		# MDIO support
device		qcom_tsens		# TSENS temperature sensors

# Real-time clocks on Qualcomm boards' I2C buses
device		ds13rtc			# DS13xx and compatible (Radxa Dragon Q8B)

# Serial (COM) ports
device		uart_msm		# Qualcomm MSM UART driver
device		uart_qcom_geni		# Qualcomm GENI UART

# TLMM driver
device		qcom_tlmm

# MMC/SD/SDIO Card slot support
device		sdhci

options 	FDT

# DTBs
makeoptions	MODULES_EXTRA+="dtb/qcom"
